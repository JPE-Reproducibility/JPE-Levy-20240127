@article{ARZHEIMER2019102040,
	abstract = {Until 2017, Germany was an exception to the success of radical right parties in postwar Europe. We provide new evidence for the transformation of the Alternative for Germany (AfD) to a radical right party drawing upon social media data. Further, we demonstrate that the AfD's electorate now matches the radical right template of other countries and that its trajectory mirrors the ideological shift of the party. Using data from the 2013 to 2017 series of German Longitudinal Elections Study (GLES) tracking polls, we employ multilevel modelling to test our argument on support for the AfD. We find the AfD's support now resembles the image of European radical right voters. Specifically, general right-wing views and negative attitudes towards immigration have become the main motivation to vote for the AfD. This, together with the increased salience of immigration and the AfD's new ideological profile, explains the party's rise.},
	author = {Kai Arzheimer and Carl C. Berning},
	date-added = {2020-10-28 20:15:20 -0400},
	date-modified = {2020-10-28 20:15:20 -0400},
	doi = {https://doi.org/10.1016/j.electstud.2019.04.004},
	issn = {0261-3794},
	journal = {Electoral Studies},
	keywords = {Germany, Radical right, Anti-immigration attitudes, Multi-level model},
	pages = {102040},
	title = {How the Alternative for Germany (AfD) and their voters veered to the radical right, 2013--2017},
	url = {http://www.sciencedirect.com/science/article/pii/S0261379418305158},
	volume = {60},
	year = {2019},
	Bdsk-Url-1 = {http://www.sciencedirect.com/science/article/pii/S0261379418305158},
	Bdsk-Url-2 = {https://doi.org/10.1016/j.electstud.2019.04.004}}

