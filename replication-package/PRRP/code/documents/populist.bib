@article{bonomiIdentityBeliefsPolitical2020,
  title = {Identity, {{Beliefs}}, and {{Political Conflict}}},
  author = {Bonomi, Giampaolo and Gennaioli, Nicola and Tabellini, Guido},
  year = {2020},
  abstract = {We present a theory of identity politics that builds on two ideas. First, when policy con\textdaggerdbl ict renders a certain social divide (economic of cultural) salient, a voter's beliefs are tainted by the stereotype of the group he identi\ldots es with. Second, culture in\textdaggerdbl uences beliefs across many domains. The theory yields two main implications: i) voters'beliefs are polarized along the distinctive features of salient groups; ii) cultural change and speci\ldots c economic shocks can render cultural groups salient, inducing large and non standard changes in beliefs and policies. In particular, shocks concentrating economic losses on social conservative groups (e.g., globalization) can induce voters to switch from class to cultural identity, dampening their demand for redistribution and exacerbating con\textdaggerdbl ict in other social dimensions. We show that U.S. survey evidence is broadly consistent with these implications.},
  file = {C\:\\Users\\roee2\\Zotero\\storage\\RCABI6FS\\Bonomi et al. - Identity, Beliefs, and Political Con‡ict.pdf},
  language = {en}
}

